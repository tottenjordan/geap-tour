__pycache__/
*.pyc
.env
.env.*
!.env.example
.venv/
dist/
*.egg-info/
# Diagram outputs are committed for the workshop
# diagrams/outputs/*.png
# diagrams/outputs/*.jpeg
.uv/
*.pdf
.playwright-mcp/
.pytest_cache/

# Secrets and credentials
*.pem
*.key
*.p12
*.json.bak
service-account*.json
credentials*.json
*secret*
!scripts/toolspecs/*

# GCP raw exports (may contain env vars / secrets from other services)
docs/verification/*.raw.json

# OS / editor
.DS_Store
*.swp
*.swo
*~
eval_outputs/
# Singular too. config.py's EVAL_OUTPUT_DIR is "eval_outputs" (plural), but ad-hoc
# `> eval_output/run.log` redirects are easy to typo and the one-character miss
# meant a scratch dir sat in `git status` as untracked for a whole working session
# — surviving only because every `git add` named explicit paths. A bare
# `git add -A` would have committed it.
eval_output/
eval_results_*.json
# Scratch stdout/stderr from long-running eval and deploy commands. Never content:
# anything worth keeping goes in docs/notes/ or a committed JSON artifact.
*.log
*.err

# Compiled KFP pipeline specs — build artifacts regenerated by
# src/pipelines/submit.py and submit_optimize.py (DOE runs nest their own
# per-design-point specs under doe_runs/<experiment_id>/ instead).
build/

# DOE run artifacts (manifests, results, compiled specs, reports)
doe_runs/

# Legacy compiled specs from before build/ existed (repo-root leftovers)
eval_pipeline.yaml
eval_pipeline.json
optimize_pipeline.yaml
optimize_pipeline.json
eval_pipeline_*.yaml
eval_pipeline_*.json
optimize_pipeline_*.yaml

# PaperBanana diagram generation outputs
outputs/
