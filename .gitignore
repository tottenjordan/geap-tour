__pycache__/
*.pyc
.env
.env.*
!.env.example
.venv/
dist/
*.egg-info/
# Diagram outputs are committed for the workshop
# diagrams/outputs/*.png
# diagrams/outputs/*.jpeg
.uv/
*.pdf
.playwright-mcp/
.pytest_cache/

# Secrets and credentials
*.pem
*.key
*.p12
*.json.bak
service-account*.json
credentials*.json
*secret*
!scripts/toolspecs/*

# GCP raw exports (may contain env vars / secrets from other services)
docs/verification/*.raw.json

# OS / editor
.DS_Store
*.swp
*.swo
*~
eval_outputs/
# Singular too. config.py's EVAL_OUTPUT_DIR is "eval_outputs" (plural), but ad-hoc
# `> eval_output/run.log` redirects are easy to typo and the one-character miss
# meant a scratch dir sat in `git status` as untracked for a whole working session
# — surviving only because every `git add` named explicit paths. A bare
# `git add -A` would have committed it.
eval_output/
eval_results_*.json
# Scratch stdout/stderr from long-running eval and deploy commands. Never content:
# anything worth keeping goes in docs/notes/ or a committed JSON artifact.
*.log
*.err

# Compiled KFP pipeline specs — build artifacts regenerated by
# src/pipelines/submit.py and submit_optimize.py (DOE runs nest their own
# per-design-point specs under doe_runs/<experiment_id>/ instead).
build/

# DOE run artifacts (manifests, results, compiled specs, reports)
doe_runs/

# Legacy compiled specs from before build/ existed (repo-root leftovers)
eval_pipeline.yaml
eval_pipeline.json
optimize_pipeline.yaml
optimize_pipeline.json
eval_pipeline_*.yaml
eval_pipeline_*.json
optimize_pipeline_*.yaml

# PaperBanana run scaffolding — per-run prompts, critic iterations, intermediates.
# ANCHORED and SPECIFIC, because the unanchored `outputs/` this replaces matched any
# directory of that name at any depth, including the one holding the FINAL diagrams.
# Those eight PNGs are committed on purpose — scripts/generate_pptx.py embeds seven of
# them and CI builds the deck from a clean checkout — and they survived only because
# they were tracked before the rule existed. A NINTH diagram would have been silently
# ignored, absent from CI's checkout, and dropped from the deck without complaint
# (add_image_safe returns False and no caller checks it).
/outputs/
/diagrams/outputs/batch_*/

# Generated workshop deck — rebuilt in ~4s by scripts/generate_pptx.py.
# 28MB of embedded screenshots; a new binary blob per regeneration is not worth
# carrying in history. CI builds it and uploads it as a downloadable artifact.
docs/slides.pptx
