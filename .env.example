# --- GCP Project ---
GCP_PROJECT_ID=your-project-id
PROJECT_NUMBER=your-project-number
GCP_REGION=us-central1
GCP_STAGING_BUCKET=your-staging-bucket

# --- MCP Server Cloud Run URLs (fallback when Agent Registry is unavailable) ---
SEARCH_MCP_URL=https://search-mcp-xxxxx-uc.a.run.app/mcp
BOOKING_MCP_URL=https://booking-mcp-xxxxx-uc.a.run.app/mcp
EXPENSE_MCP_URL=https://expense-mcp-xxxxx-uc.a.run.app/mcp

# --- Agent Registry MCP Server Resource Names ---
SEARCH_MCP_SERVER=projects/your-project-id/locations/us-central1/mcpServers/search-mcp
BOOKING_MCP_SERVER=projects/your-project-id/locations/us-central1/mcpServers/booking-mcp
EXPENSE_MCP_SERVER=projects/your-project-id/locations/us-central1/mcpServers/expense-mcp

# --- Agent Identity & Gateway ---
ENABLE_AGENT_IDENTITY=false
ENABLE_AGENT_GATEWAY=false
AGENT_GATEWAY_PATH=projects/your-project-id/locations/us-central1/agentGateways/your-gateway
AGENT_GATEWAY_EGRESS_PATH=projects/your-project-id/locations/us-central1/agentGateways/your-gateway-egress

# --- Agent Armor (Model Armor templates) ---
MODEL_ARMOR_PROMPT_TEMPLATE=projects/your-project-id/locations/us-central1/templates/geap-workshop-prompt
MODEL_ARMOR_RESPONSE_TEMPLATE=projects/your-project-id/locations/us-central1/templates/geap-workshop-response

# --- Vertex AI ---
GOOGLE_GENAI_USE_VERTEXAI=1

# --- Multi-model Router ---
LITE_MODEL=gemini-3.1-flash-lite
FLASH_MODEL=gemini-3.5-flash
PRO_MODEL=gemini-3.1-pro-preview
SONNET_MODEL=claude-sonnet-4-6
OPUS_MODEL=claude-opus-4-6
CLASSIFIER_MODEL=gemini-3.5-flash
# The router has exactly FOUR cut-points, in this order. Defaults shown are the
# live values (DOE-tuned, then corrected by paired SxS — see src/config.py for
# the evidence behind each). A fifth spelling, COMPLEXITY_THRESHOLD_HIGH, used to
# sit here set to 0.65: nothing ever read it from the environment, so tuning the
# router through that name silently did nothing. It is gone; use these.
COMPLEXITY_LOW=0.25
MEDIUM_SPLIT=0.60
COMPLEXITY_HIGH=0.925
HIGH_SPLIT=0.95

# --- Other Models ---
AGENT_MODEL=gemini-3.5-flash
SIMULATOR_MODEL=gemini-2.5-flash

# --- Agent Engine IDs (populated by deploy_agents.py) ---
# AGENT_ENGINE_ID and COORDINATOR_AGENT_ID look redundant and are not: the
# coordinator-specific name takes precedence wherever both are read, so a router
# id in the shared slot can no longer be mistaken for the coordinator's. The
# precedence is pinned by tests/test_no_hardcoded_values.py.
AGENT_ENGINE_ID=
ROUTER_ENGINE_ID=
COORDINATOR_AGENT_ID=
LITE_ENGINE_ID=
FLASH_ENGINE_ID=
PRO_ENGINE_ID=
SONNET_ENGINE_ID=
OPUS_ENGINE_ID=

# --- Feature flags (all optional; unset == the default shown) ---
# Every one of these is read by src/config.py and, where relevant, baked into the
# deployed engine's env by deploy_agents.py. They were previously discoverable
# only by grepping the source, which is backwards: the flags are the most
# interesting surface here and were the least documented.
ENABLE_MEMORY_BANK=1              # cross-session recall; 0 drops the preload tool AND the save callback
ENABLE_MODEL_ARMOR_PLUGIN=1       # ADK's first-party Model Armor plugin
ENABLE_MEMORY_PRELOAD_CACHE=0     # memoize Memory Bank retrieve per invocation (latency knob)
ENABLE_SKILL_REGISTRY=0           # opt-in SkillToolset; see docs/notes/skill-registry.md before enabling
ENABLE_SPAN_CONTENT_CAPTURE=0     # writes prompt/response into Cloud Trace — privacy-relevant
ENABLE_AGENT_ANALYTICS=0          # BigQuery content logging; needs the `analytics` dependency group
